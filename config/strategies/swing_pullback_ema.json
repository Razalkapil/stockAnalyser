{
  "dsl_version": 1,
  "slug": "swing_pullback_ema",
  "name": "Pullback to 20/50 EMA in an uptrend",
  "horizon": "swing",
  "universe": {
    "exchange": "NSE",
    "min_price_raw": 20,
    "min_median_turnover_inr": 20000000,
    "min_listed_days": 120,
    "exclude_series": [
      "SM",
      "ST",
      "MF",
      "GB",
      "IV"
    ]
  },
  "params": {
    "rsi_lo": {
      "default": 40,
      "grid": [
        35,
        40,
        45
      ]
    }
  },
  "entry": {
    "all": [
      {
        "left": {
          "ind": "ema",
          "period": 20
        },
        "op": ">",
        "right": {
          "ind": "ema",
          "period": 50
        }
      },
      {
        "left": {
          "ind": "close"
        },
        "op": ">",
        "right": {
          "ind": "sma",
          "period": 200
        }
      },
      {
        "left": {
          "ind": "low"
        },
        "op": "<=",
        "right": {
          "mul": [
            1.01,
            {
              "ind": "ema",
              "period": 20
            }
          ]
        }
      },
      {
        "left": {
          "ind": "rsi",
          "period": 14
        },
        "op": "between",
        "right": [
          {
            "param": "rsi_lo"
          },
          55
        ]
      }
    ]
  },
  "exit": {
    "stop": {
      "type": "atr",
      "mult": 2.0
    },
    "target": {
      "type": "atr",
      "mult": 4.0
    },
    "max_hold_days": 30
  },
  "rank": {
    "by": [
      {
        "ind": "rs",
        "period": 126,
        "dir": "desc"
      }
    ],
    "max_new_per_day": 3
  },
  "sizing": {
    "max_positions": 10
  }
}
