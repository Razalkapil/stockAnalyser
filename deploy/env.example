# /etc/stockanalyser/env  --  chmod 600, owner root:stk. Never commit the real file.
# Read by every stk-*.service via EnvironmentFile=.

# Selects config/env/prod.yaml (data root /srv/stockanalyser/data, INFO logging).
STK_APP__ENV=prod

# Claude API key for the AI evening review and weekly strategy lab. Optional: without it the
# AI steps record a failure in ai_runs, `stk doctor` says so after three, and nothing else stops.
ANTHROPIC_API_KEY=

# Where backups go. Must NOT be inside /srv/stockanalyser/data. Used by backup.sh.
STK_BACKUP_DEST=/srv/stockanalyser/backups

# Optional off-box copy, run by backup.sh after a verified backup. $STK_BACKUP_DEST is the local
# directory. A backup that only exists on the VM is lost with the VM. Example (rclone to OCI
# object storage, which has an Always Free allowance):
#   STK_OFFSITE_CMD=rclone sync /srv/stockanalyser/backups oci:stk-backups
STK_OFFSITE_CMD=
