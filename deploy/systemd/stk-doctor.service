[Unit]
Description=stk doctor (data, jobs, AI, poller and backup health)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stk
Group=stk
WorkingDirectory=/srv/stockanalyser/app
EnvironmentFile=/etc/stockanalyser/env
ExecStart=/srv/stockanalyser/app/.venv/bin/stk doctor --backup-dest /srv/stockanalyser/backups
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/stockanalyser
