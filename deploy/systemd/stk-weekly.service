[Unit]
Description=stk weekly run (master, calendar, filings + XBRL, AI strategy lab)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stk
Group=stk
WorkingDirectory=/srv/stockanalyser/app
EnvironmentFile=/etc/stockanalyser/env
ExecStart=/srv/stockanalyser/app/.venv/bin/stk weekly
TimeoutStartSec=8h
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/stockanalyser
