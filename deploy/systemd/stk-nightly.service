[Unit]
Description=stk nightly run (prices, scan, track, paper EOD, AI review)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stk
Group=stk
WorkingDirectory=/srv/stockanalyser/app
EnvironmentFile=/etc/stockanalyser/env
ExecStart=/srv/stockanalyser/app/.venv/bin/stk nightly
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/stockanalyser
