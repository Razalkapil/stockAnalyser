# Copy to .env and fill in. Never commit .env.
STK_APP__ENV=local

# Single-user bearer token for the dashboard API (phase 4+). Generate with:
#   openssl rand -hex 32
# Set it here and it works -- `stk api serve` passes it to the app, and it is accepted
# alongside any token made with `stk api token create`. Minimum 32 characters; a shorter
# one is refused at startup. Leave blank to use database tokens only.
STK_AUTH__TOKEN=

# API key for the AI evening review / weekly strategy lab. Set the one matching
# `provider:` in config/ai.yaml -- `stk` copies these into the environment on startup,
# because the provider SDKs read them from there, not from the STK_ settings.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Override data root, e.g. on the Oracle VM: /srv/stockanalyser/data
# STK_PATHS__DATA_ROOT=./data
