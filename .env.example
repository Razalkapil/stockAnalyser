# Copy to .env and fill in. Never commit .env.
STK_APP__ENV=local

# Single-user auth token for the API (phase 4+). Generate with: openssl rand -hex 32
STK_AUTH__TOKEN=

# Claude API key (phase 6+ AI evening review / weekly strategy lab)
ANTHROPIC_API_KEY=

# Override data root, e.g. on the Oracle VM: /srv/stockanalyser/data
# STK_PATHS__DATA_ROOT=./data
